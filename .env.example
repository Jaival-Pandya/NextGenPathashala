# Copy to .env for local development; never commit .env.
APP_ENV=development
SECRET_KEY=replace-with-a-random-secret
DATABASE_URL=sqlite:///nextgenpathashala.db
SESSION_COOKIE_SECURE=false
AUTO_CREATE_DB=false

# Optional: set this to the workspace owner email to show the private pilot-inquiry inbox.
PILOT_ADMIN_EMAIL=

# Rate-limit storage. memory:// is suitable only for a small, single-worker pilot.
# Configure a shared Redis URI before scaling to multiple workers/instances.
RATELIMIT_STORAGE_URI=memory://


# Optional generative AI tutor (OpenAI-compatible API). Configure on the server only.
# Never expose STUDY_AI_API_KEY in JavaScript or commit a real key to source control.
STUDY_AI_API_KEY=
STUDY_AI_BASE_URL=https://api.openai.com/v1
STUDY_AI_MODEL=gpt-4o-mini
STUDY_AI_TIMEOUT_SECONDS=25
