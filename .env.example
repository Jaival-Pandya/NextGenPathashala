# Copy to .env for local development; never commit .env.
APP_ENV=development
SECRET_KEY=replace-with-a-random-48-byte-secret
DATABASE_URL=sqlite:///nextgenpathashala.db
SESSION_COOKIE_SECURE=false
AUTO_CREATE_DB=false

# Optional: set this to the workspace owner email to show the private pilot-inquiry inbox.
PILOT_ADMIN_EMAIL=

# Rate-limit storage. memory:// is suitable only for a small, single-worker pilot.
# Configure a shared Redis URI before scaling to multiple workers/instances.
RATELIMIT_STORAGE_URI=memory://


# Optional generative AI tutor. Configure on the server only.
# Hosted OpenAI-compatible provider:
STUDY_AI_PROVIDER=openai
STUDY_AI_API_KEY=
STUDY_AI_BASE_URL=https://api.openai.com/v1
STUDY_AI_MODEL=gpt-4o-mini
STUDY_AI_TIMEOUT_SECONDS=25
STUDY_AI_MAX_TOKENS=900
# OpenRouter example (OpenAI-compatible; free models are rate-limited):
# STUDY_AI_PROVIDER=openrouter
# STUDY_AI_API_KEY=
# STUDY_AI_BASE_URL=https://openrouter.ai/api/v1
# STUDY_AI_MODEL=openrouter/free
# STUDY_AI_TIMEOUT_SECONDS=40
# STUDY_AI_MAX_TOKENS=1600
# Optional web fallback, used only when uploaded-note retrieval finds no match.
STUDY_WEB_SEARCH_API_KEY=
STUDY_WEB_SEARCH_TIMEOUT_SECONDS=5
# For local Ollama, set provider=ollama, base URL=http://localhost:11434/v1,
# model=llama3.2:3b, and leave STUDY_AI_API_KEY empty. The model must be pulled
# on the machine running this app; localhost refers to that server, not students' devices.
